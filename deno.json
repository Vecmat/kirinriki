{
    "name": "@vecmat/kirinriki",
    "version": "1.0.4",
    "description": "基于 Hono 的企业级 TypeScript Web 框架：IOC 依赖注入、装饰器路由、参数提取与 zod 校验、AOP 切面、全局异常处理，支持 Node.js / Deno / Bun / Cloudflare Workers。",
    "exports": "./src/mod.ts",
    "workspace": [
        "./example"
    ],
    "publish": {
        "include": [
            "src/**/*.ts",
            "deno.json",
            "LICENSE",
            "README.md"
        ],
        "exclude": [
            "example/**",
            "dist/**",
            "node_modules/**",
            "**/*.test.ts",
            "**/*.spec.ts",
            "inject.ts",
            ".github/**",
            ".vscode/**",
            ".idea/**"
        ]
    },
    "compilerOptions": {
        "experimentalDecorators": true
    },
    "unstable": [
        "sloppy-imports"
    ],
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno task --cwd example dev",
        "start": "deno task --cwd example start",
        "version:patch": "node scripts/bump-version.mjs",
        "publish:dry": "deno publish --dry-run"
    },
    "lint": {
        "rules": {
            "include": [
                "require-await"
            ],
            "exclude": [
                "no-sloppy-imports"
            ]
        }
    }
}
