{
    "name": "@kirinriki/example",
    "version": "0.0.0",
    "private": true,
    "description": "Kirinriki 框架示例（多应用：auth / payment）。通过 file:.. workspace 方式引用本地框架。",
    "scripts": {
        "build:framework": "npm --prefix .. run build",
        "build": "npm run build:framework && tsc",
        "start": "node dist/main.js",
        "dev": "npm run build && npm run start",
        "check": "tsc --noEmit",
        "start:deno": "deno task start",
        "start:bun": "bun run main.ts"
    },
    "dependencies": {
        "@vecmat/kirinriki": "file:..",
        "@hono/node-server": "^2.1.1",
        "hono": "^4.13.9",
        "reflect-metadata": "^0.2.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/reflect-metadata": "^0.0.5",
        "typescript": "^7.0.2"
    }
}
