{
    "name": "@vecmat/kirinriki",
    "version": "1.0.2",
    "description": "基于 Hono 的企业级 TypeScript Web 框架：IOC 依赖注入、装饰器路由、参数提取与 zod 校验、AOP 切面、全局异常处理，支持 Node.js / Deno / Bun / Cloudflare Workers。",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "build:example": "tsc -p tsconfig.example.json",
        "example": "npm run build && npm run build:example && node dist-example/example/main.js",
        "dev": "npm run example",
        "example:deno": "deno task start",
        "example:bun": "bun run example/main.ts",
        "version:patch": "node scripts/bump-version.mjs",
        "release": "node scripts/bump-version.mjs && npx jsr publish",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [
        "hono",
        "web",
        "framework",
        "ioc",
        "di",
        "decorators",
        "aop",
        "typescript",
        "deno",
        "bun",
        "cloudflare-workers"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "hono": "^4.13.9",
        "reflect-metadata": "^0.2.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@hono/node-server": "^2.1.1",
        "@types/node": "^26.6.2",
        "@types/reflect-metadata": "^0.0.5",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2"
    }
}
