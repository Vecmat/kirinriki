{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "types": [
            "node",
            "vitest/globals",
            "reflect-metadata"
        ],
        "rootDir": "..",
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false
    },
    "include": [
        "**/*.ts",
        "../src/**/*.ts"
    ],
    "exclude": [
        "../node_modules",
        "../dist"
    ]
}